; # Rosetta Code: FizzBuzz
;   https://rosettacode.org/wiki/FizzBuzz

; Solution 1: Using cases (idiomatic Rye)
for range 1 100 { ::n
	cases " " {
		{ n .is-multiple-of 3 } { "Fizz" }
		{ n .is-multiple-of 5 } { ++ "Buzz" }
		_ { n }
	} |prns
}

; Solution 2: Using either chains
for range 1 100 { ::n
	either n .is-multiple-of 15 { "FizzBuzz" }
	{ either n .is-multiple-of 3 { "Fizz" }
	{ either n .is-multiple-of 5 { "Buzz" }
	{ n } } } |prns
}
