nd ; # Rosetta Code: Letter frequency
;   https://rosettacode.org/wiki/Letter_frequency

; Count occurrences of ch in text using split trick
count-ch: fn { text ch } {
	split text ch |length? |+ -1
}

letter-frequency: fn { text } {
	ltext: lower text
	chars: unique ltext .sort
	chars |for { ::ch
		count-ch ltext ch ::freq
		print join { "  " ch ": " string freq }
	}
}

text: "aabbbcccc"
print join { "Text: " text }
print "Frequencies:"
letter-frequency text

print ""

text2: "Hello World"
print join { "Text: " text2 }
print "Frequencies:"
letter-frequency text2

