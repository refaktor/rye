section "baseio/builtins_printing.go" "Interactive display and table printing helpers." {
section "Printing" "Interactive display and table printing helpers." {
	group "display"
	"Displays all entries without interaction or pagination and returns the original value."
	{
		argsn 1
		arg `value: Rye value to display without interaction or pagination`
		returns `the original value`
	}

	{
		stdout { display 42 |type? } "42\n"
	}

	{
		"display [1 2 3]"
	}

	group "explore"
	"Interactively explores a value; returns the selected item or the original value when cancelled."
	{
		argsn 1
		arg `value: Block, Dict, Table, TableRow, Markdown, or Error to explore`
		returns `the selected item or the original value when cancelled`
	}

	{
	}

	{
		"[1 2 3] |explore"
	}

	group "_.."
	"Shorthand alias for explore: interactively select a value."
	{
		argsn 1
		arg `value: Block, Dict, Table, TableRow, Markdown, or Error to explore interactively`
		returns `the selected value or the original value when user exits`
	}

	{
	}

	{
		"_.. [1 2 3]"
	}

	group "explore\\custom"
	"Interactively displays a Table in the terminal with a custom rendering function for each row."
	{
		argsn 2
		arg `table: Table to display`
		arg `renderer: Function called for each row with args (row is-current)`
		returns `the selected row or original table when user exits`
	}

	{
	}

	{
		"table { \"n\" } { 1 2 3 } |explore\\custom fn { row is-curr } { if is-curr > 0 { print \"*\" } print row }"
	}

	group "print\\ssv"
	"Prints a block of values as space-separated values followed by a newline, returning the input block."
	{
		argsn 1
		arg `values: Block to format as space-separated values`
		returns `the input block, unchanged`
	}

	{
		stdout { print\ssv { 1 2 "a" } } "1 2 a\n"
	}

	{
	}

	group "print\\csv"
	"Prints a block of values as comma-separated values followed by a newline, returning the input block."
	{
		argsn 1
		arg `values: Block to format as comma-separated values`
		returns `the input block, unchanged`
	}

	{
		stdout { print\csv { 1 2 "a" } } "1,2,a\n"
	}

	{
	}

}
}
section "baseio/builtins_baseio.go" "Saving state, loading scripts, process arguments, exit, and sandbox controls." {
section "Runtime and Process Integration" "Saving state, loading scripts, process arguments, exit, and sandbox controls." {
	group "scmd"
	"Execute a shell command and return its exit status code."
	{
		argsn 1
		arg `cmd: Shell command string to execute`
		returns `integer exit status code`
	}

	{
		equal { scmd "exit 0" } 0
		equal { scmd "exit 3" } 3
		error { scmd 123 }
	}

	{
	}

	group "scmd\\capture"
	"Execute a shell command and capture the output, return it as string"
	{
		argsn 1
		arg `cmd: Shell command string to execute and capture output`
		returns `string containing captured stdout (stderr on error)`
	}

	{
		equal { scmd\capture "echo hi" } "hi\n"
		error { scmd\capture 123 }
	}

	{
	}

	group "exit"
	"Exits the process with the given integer status code (or 0 for any non-integer)."
	{
		argsn 1
		arg `status: Integer process exit status; non-integers exit with 0.`
		returns `does not return; terminates the process.`
	}

	{
	}

	{
		"; exit 0"
	}

	group "Rye-itself//Args?"
	"Returns command line arguments as a block of parsed values. Each argument is converted to appropriate type (integer, float, or string)."
	{
		arg `none`
		returns `block of values (each arg parsed as integer, float, or string)`
	}

	{
	}

	{
		"Rye-itself//Args?"
	}

	group "Rye-itself//Args\\raw?"
	"Returns raw command line arguments joined as a single string."
	{
		argsn 1
		arg `separator (ignored currently; kept for future parity) – pass _`
		returns `string`
	}

	{
	}

	{
		"Rye-itself//Args\\\\raw? _"
	}

	group "Rye-itself//History?"
	"Returns a block of the last N lines from REPL history."
	{
		argsn 2
		arg `rye-itself: Native Rye-itself object passed via dot dispatch.`
		arg `count: Integer number of history lines to return.`
		returns `Block of strings from REPL history; error when not running in the REPL.`
	}

	{
	}

	{
		"Rye-itself//History? _ 10"
	}

	group "Rye-itself//Landlock"
	"Create a landlock builder object that can be configured and then enforced."
	{
		arg `none`
		returns `native 'landlock' builder`
	}

	{
	}

	{
		"ll: Rye-itself//Landlock\nll | landlock//Limit-to-cwd | landlock//Enforce"
	}

	group "landlock//Limit-to-cwd"
	"Limit landlock to current working directory (configure; does not enforce yet)."
	{
		argsn 1
		arg `landlock native`
		returns `same native (builder)`
	}

	{
	}

	{
	}

	group "landlock//Allow"
	"Allow access to a specific path (file or directory)."
	{
		argsn 2
		arg `landlock native, path (uri|string)`
		returns `same native (builder)`
	}

	{
	}

	{
	}

	group "landlock//Allow-exec"
	"Allow execute access to a specific file (or RX for all files under a directory)."
	{
		argsn 2
		arg `landlock native, path (uri|string)`
		returns `same native (builder)`
	}

	{
	}

	{
	}

	group "landlock//Enforce"
	"Enforce the configured landlock ruleset exactly once."
	{
		argsn 1
		arg `landlock native`
		returns `same native (builder)`
	}

	{
	}

	{
	}

	group "Rye-itself//Landlock-to-cwd"
	"Restrict filesystem access to the current working directory and its subdirectories using Landlock (Linux only). Call early in the script."
	{
		arg `none`
		returns `'ok tagword on success; error on failure`
	}

	{
	}

	{
	}

	group "Rye-itself//Landlock-only"
	"Immediately restrict filesystem access to the provided list of paths with modes r, rw, or rx. Example: Rye-itself//Landlock-only \"/proj:r,/tmp:rw,/proj/bin:rx\""
	{
		argsn 1
		arg `spec (string or block of strings). Spec format examples:`
		arg `"/proj:r,/proj/bin:rx,/tmp:rw" or block [ "/proj:r" "/proj/bin:rx" "/tmp:rw" ]`
		returns `'ok tagword on success; error on failure`
	}

	{
	}

	{
	}

	group "Rye-itself//Is-unshare-fs"
	"Returns true if filesystem namespace isolation is enabled under --unshare."
	{
		pure
		arg `none`
		returns `boolean`
	}

	{
	}

	{
	}

	group "Rye-itself//Is-unshare-net"
	"Returns true if network namespace isolation is enabled under --unshare."
	{
		pure
		arg `none`
		returns `boolean`
	}

	{
	}

	{
	}

	group "Rye-itself//Is-unshare-pid"
	"Returns true if PID namespace isolation is enabled under --unshare."
	{
		pure
		arg `none`
		returns `boolean`
	}

	{
	}

	{
	}

	group "Rye-itself//Is-unshare-uts"
	"Returns true if UTS namespace isolation is enabled under --unshare."
	{
		pure
		arg `none`
		returns `boolean`
	}

	{
	}

	{
	}

	group "Rye-itself//Unshare-config?"
	"Returns a dictionary with unshare isolation flags: active, fs, net, pid, uts (booleans)."
	{
		pure
		arg `none`
		returns `dict with keys: active, fs, net, pid, uts (booleans)`
	}

	{
	}

	{
		"cc Rye-itself Unshare-config? |print"
	}

	group "Rye-itself//Is-unshare"
	"Returns true if current process runs inside Rye --unshare sandbox (Linux only)."
	{
		pure
		arg `none`
		returns `boolean, true when the runner set RYE_UNSHARE_CHILD=1`
	}

	{
	}

	{
	}

	group "Rye-itself//Require-unshared"
	"Fails and exits if unshare is not active (use in CI/safety-critical runs)."
	{
		arg `none`
		returns `never on failure (process exits); 'ok tagword when already unshared`
	}

	{
	}

	{
	}

	group "Rye-itself//Is-dry-run"
	"Returns true if Rye is running in dry-run/scenario mode (activated via --dry-run or scenario context)"
	{
		pure
		arg `none`
		returns `boolean, true when --dry-run is active or a scenario context is detected`
	}

	{
	}

	{
	}

	group "capture-stdout"
	"Executes a block of code while capturing all output to stdout, returning the captured output as a string."
	{
		argsn 1
		arg `block: Block whose stdout should be captured.`
		returns `String containing the captured stdout.`
	}

	{
		equal { capture-stdout { print 1 } } "1\n"
		error { capture-stdout 1 }
	}

	{
	}

}
}
section "baseio/builtins_io.go" "Console input and output functions" {
section "Console IO" "Console input and output functions" {
	group "input"
	"Prompts for and reads user input from the console."
	{
		argsn 1
		arg `prompt: string to display as a prompt`
		returns `string containing the user's input`
	}

	{
	}

	{
		"; File operations\nfile: Create %output.txt\nfile .Write \"Hello, World!\\n\"\nfile .Close\nRead %output.txt |print\n\n; Reader/Writer operations\nreader: Reader %data.txt\ncontent: reader .Read\\string\nreader .Close\nprint content\n\n; HTTP requests\nGet https://api.example.com/data |print\nPost https://api.example.com/data \"{\\\"name\\\":\\\"test\\\"}\" 'json |print\n"
	}

}

section "File Operations" "File system operations and file manipulation" {
	group "file-uri//Open"
	"Opens a file for reading."
	{
		argsn 1
		arg `path: uri representing the file to open`
		returns `native file object`
	}

	{
		equal { Open %data/file.txt |type? } 'native
		equal { Open %data/file.txt |kind? } 'file
	}

	{
	}

	group "file-uri//Open\\append"
	"Opens a file for appending."
	{
		argsn 1
		arg `path: uri representing the file to open for appending`
		returns `native writer object`
	}

	{
		equal { Open\append %data/file.txt |type? } 'native
		equal { Open\append %data/file.txt |kind? } 'file
	}

	{
	}

	group "file-uri//Create"
	"Creates a new file."
	{
		argsn 1
		arg `path: uri representing the file to create`
		returns `native file object`
	}

	{
		equal { Create %data/created.txt |type? } 'native
		equal { Create %data/created.txt |kind? } 'file
	}

	{
	}

	group "file-uri//Ext?"
	"Gets the extension of a file."
	{
		argsn 1
		arg `path: uri or string representing a file path`
		returns `string containing the file extension (including the dot)`
	}

	{
		equal { Ext? %data/file.txt } ".txt"
		equal { Ext? %data/file.temp.png } ".png"
		equal { Ext? file "data/file.temp.png" } ".png"
	}

	{
	}

	group "file-uri//Name?"
	"Gets the filename with extension from a file path."
	{
		argsn 1
		arg `path: uri representing a file path`
		returns `string containing the filename with extension`
	}

	{
		equal { Name? %data/file.txt } "file.txt"
	}

	{
	}

	group "file-uri//Stem?"
	"Gets the filename without extension from a file path."
	{
		argsn 1
		arg `path: uri representing a file path`
		returns `string containing the filename without extension`
	}

	{
		equal { Stem? %data/file.txt } "file"
	}

	{
	}

	group "file-uri//Dir?"
	"Gets the directory path from a file path."
	{
		argsn 1
		arg `path: uri representing a file path`
		returns `string containing the directory path`
	}

	{
		equal { Dir? %data/file.txt } "data"
	}

	{
	}

	group "file-uri//Split"
	"Splits a file path into its components."
	{
		argsn 1
		arg `path: uri representing a file path`
		returns `block of strings containing path components`
	}

	{
		equal { Split %data/file.txt } { "data" "file.txt" }
	}

	{
	}

	group "file-uri//Is-absolute"
	"Checks if a file path is absolute."
	{
		argsn 1
		arg `path: uri representing a file path`
		returns `boolean indicating whether the path is absolute`
	}

	{
		equal { Is-absolute %/tmp } true
		equal { Is-absolute %data/file.txt } false
	}

	{
	}

	group "file-uri//Does-exist"
	"Checks if a file exists."
	{
		argsn 1
		arg `path: uri representing a file path`
		returns `boolean indicating whether the file exists`
	}

	{
		equal { Does-exist %data/file.txt } true
		equal { Does-exist %data/nonexistent.txt } false
	}

	{
	}

	group "file-uri//Delete"
	"Deletes a file."
	{
		argsn 1
		arg `path: uri representing a file path to delete`
		returns `true if the file was successfully deleted`
	}

	{
	}

	{
	}

	group "file//Reader"
	"Creates a new reader from file object."
	{
		argsn 1
		arg `source: file object to read from`
		returns `native reader object`
	}

	{
		equal { Reader Open %data/file.txt |kind? } 'reader
	}

	{
	}

	group "file//Writer"
	"Creates a new writer from a file object."
	{
		argsn 1
		arg `source: file object to write to`
		returns `native writer object`
	}

	{
		equal { Writer Open %data/file.txt |kind? } 'writer
	}

	{
	}

	group "file-uri//Reader"
	"Creates a new reader from a file uri/path."
	{
		argsn 1
		arg `source: file uri to read from`
		returns `native reader object`
	}

	{
		equal { Reader %data/file.txt |kind? } 'reader
	}

	{
	}

	group "reader"
	"Creates a new reader from a string."
	{
		argsn 1
		arg `source: string to read from`
		returns `native reader object`
	}

	{
		equal { reader "some string" |kind? } 'reader
	}

	{
	}

	group "stdin"
	"Gets a reader for standard input."
	{
		arg `none`
		returns `native reader object connected to standard input`
	}

	{
	}

	{
	}

	group "stdout"
	"Gets a writer for standard output."
	{
		arg `none`
		returns `native writer object connected to standard output`
	}

	{
	}

	{
	}

	group "stderr"
	"Gets a writer for standard error."
	{
		arg `none`
		returns `native writer object connected to standard error`
	}

	{
	}

	{
	}

	group "reader//Read\\string"
	"Reads all content from a reader as a string."
	{
		argsn 1
		arg `reader: native reader object`
		returns `string containing all content from the reader`
	}

	{
		equal { reader "some string" |Read\string } "some string"
	}

	{
	}

	group "reader//Close"
	"Closes a reader if it implements io.Closer."
	{
		argsn 1
		arg `reader: native reader object`
		returns `empty string if successful`
	}

	{
		equal { Reader %data/file.txt |Close |type? } 'string
	}

	{
	}

	group "reader//Copy"
	"Copies all content from a reader to a writer."
	{
		argsn 2
		arg `reader: native reader object`
		arg `writer: native writer object`
		returns `the reader object if successful`
	}

	{
	}

	{
	}

	group "file//Copy"
	"Copies content from a file to a writer."
	{
		argsn 2
		arg `file: native file object`
		arg `writer: native writer object`
		returns `the file object if successful`
	}

	{
	}

	{
	}

	group "file//Stat"
	"Gets file information (stat) for a file."
	{
		argsn 1
		arg `file: native file object`
		returns `native file-info object`
	}

	{
		equal { Stat Open %data/file.txt |kind? } 'file-info
	}

	{
	}

	group "file-info//Size?"
	"Gets the size of a file in bytes."
	{
		argsn 1
		arg `file-info: native file-info object`
		returns `integer representing the file size in bytes`
	}

	{
		equal { Size? Stat Open %data/file.txt } 16
	}

	{
	}

	group "file//Read"
	"Reads the entire content of a file as a string."
	{
		argsn 1
		arg `file: native file object`
		returns `string containing the entire file content`
	}

	{
		equal { Read Open %data/file.txt } "hello text file\n"
	}

	{
	}

	group "file//Seek\\end"
	"Seeks to the end of a file."
	{
		argsn 1
		arg `file: native file object`
		returns `the same file object with position set to end of file`
	}

	{
	}

	{
	}

	group "file//Write"
	"Writes a string directly to a file object."
	{
		argsn 2
		arg `file: native file object`
		arg `content: string to write to the file`
		returns `the file object if successful (allows chaining)`
	}

	{
	}

	{
	}

	group "file//Close"
	"Closes an open file."
	{
		argsn 1
		arg `file: native file object`
		returns `empty string if successful`
	}

	{
		equal { Close Open %data/file.txt } ""
	}

	{
	}

	group "file-uri//Read"
	"Reads the entire content of a file as a string."
	{
		argsn 1
		arg `path: uri representing the file to read`
		returns `string containing the entire file content`
	}

	{
		equal { Read %data/file.txt } "hello text file\n"
	}

	{
	}

	group "file-uri//Read\\bytes"
	"Reads the entire content of a file as bytes."
	{
		argsn 1
		arg `path: uri representing the file to read`
		returns `native bytes object containing the file content`
	}

	{
		equal { Read %data/file.txt } "hello text file\n"
	}

	{
	}

	group "file-uri//Read\\lines"
	"Reads a file and returns its content as a block of lines."
	{
		argsn 1
		arg `path: uri representing the file to read`
		returns `block of strings, each representing a line from the file`
	}

	{
		equal { Read %data/file.txt } "hello text file\n"
	}

	{
	}

	group "file-uri//Write"
	"Writes content to a file."
	{
		argsn 2
		arg `path: uri representing the file to write to`
		arg `content: string or bytes to write to the file`
		returns `the content that was written`
	}

	{
		equal { Write %data/write.txt "written\n" } "written\n"
	}

	{
	}

	group "write\\bytes"
	"Writes bytes to a file."
	{
		argsn 2
		arg `bytes: Go-bytes native value to write`
		arg `path: string path to the file to write`
		returns `integer 1 if successful`
	}

	{
	}

	{
	}

	group "append\\bytes"
	"Appends two byte arrays into one."
	{
		argsn 2
		arg `bytes1: first Go-bytes native value`
		arg `bytes2: second Go-bytes native value`
		returns `combined bytes as a native bytes object`
	}

	{
	}

	{
	}

	group "writer//Write"
	"Writes a string to a writer."
	{
		argsn 2
		arg `writer: native writer object`
		arg `content: string to write`
		returns `the writer object if successful`
	}

	{
	}

	{
	}

}

section "HTTPs Operations" "Web requests and HTTP protocol functions" {
	group "https-uri//Ext?"
	"Gets the extension of the last path component of an HTTPS URL."
	{
		argsn 1
		arg `url: uri representing the HTTPS URL`
		returns `string containing the extension of the last path component`
	}

	{
		equal { Ext? uri "https://example.com/data/file.txt" } ".txt"
	}

	{
	}

	group "https-uri//Name?"
	"Gets the last path component (filename) from an HTTPS URL."
	{
		argsn 1
		arg `url: uri representing the HTTPS URL`
		returns `string containing the last path component with extension`
	}

	{
		equal { Name? uri "https://example.com/data/file.txt" } "file.txt"
	}

	{
	}

	group "https-uri//Stem?"
	"Gets the last path component (filename) without its extension from an HTTPS URL."
	{
		argsn 1
		arg `url: uri representing the HTTPS URL`
		returns `string containing the last path component without extension`
	}

	{
		equal { Stem? uri "https://example.com/data/file.txt" } "file"
	}

	{
	}

	group "https-uri//Dir?"
	"Gets the directory portion of an HTTPS URL path (including the host)."
	{
		argsn 1
		arg `url: uri representing the HTTPS URL`
		returns `string containing the directory portion of the URL path (including host)`
	}

	{
		equal { Dir? uri "https://example.com/data/file.txt" } "example.com/data"
	}

	{
	}

	group "https-uri//Open"
	"Opens a HTTPS GET request and returns a reader for the response body."
	{
		argsn 1
		arg `url: uri representing the HTTPS URL to request`
		returns `native reader object for the response body`
	}

	{
	}

	{
	}

	group "https-uri//Get"
	"Makes a HTTPS GET request and returns the response body as a string."
	{
		argsn 1
		arg `url: uri representing the HTTPS URL to request`
		returns `string containing the response body`
	}

	{
	}

	{
	}

	group "https-uri//Post"
	"Makes a HTTPS POST request and returns the response body as a string."
	{
		argsn 3
		arg `url: uri representing the HTTPS URL to request`
		arg `data: string containing the request body`
		arg `content-type: word specifying the content type (e.g., 'json', 'text')`
		returns `string containing the response body`
	}

	{
	}

	{
	}

	group "http-uri//Ext?"
	"Gets the extension of the last path component of an HTTP URL."
	{
		argsn 1
		arg `url: uri representing the HTTP URL`
		returns `string containing the extension of the last path component`
	}

	{
		equal { Ext? uri "http://example.com/data/file.txt" } ".txt"
	}

	{
	}

	group "http-uri//Name?"
	"Gets the last path component (filename) from an HTTP URL."
	{
		argsn 1
		arg `url: uri representing the HTTP URL`
		returns `string containing the last path component with extension`
	}

	{
		equal { Name? uri "http://example.com/data/file.txt" } "file.txt"
	}

	{
	}

	group "http-uri//Stem?"
	"Gets the last path component (filename) without its extension from an HTTP URL."
	{
		argsn 1
		arg `url: uri representing the HTTP URL`
		returns `string containing the last path component without extension`
	}

	{
		equal { Stem? uri "http://example.com/data/file.txt" } "file"
	}

	{
	}

	group "http-uri//Dir?"
	"Gets the directory portion of an HTTP URL path (including the host)."
	{
		argsn 1
		arg `url: uri representing the HTTP URL`
		returns `string containing the directory portion of the URL path (including host)`
	}

	{
		equal { Dir? uri "http://example.com/data/file.txt" } "example.com/data"
	}

	{
	}

	group "http-uri//Open"
	"Opens a HTTP GET request and returns a reader for the response body."
	{
		argsn 1
		arg `url: uri representing the HTTP URL to request`
		returns `native reader object for the response body`
