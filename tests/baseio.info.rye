section "baseio/builtins_table_files.go" "Load and save tables as CSV, TSV or XLSX files." {
section "Table files" "Load and save tables as CSV, TSV or XLSX files." {
	group "file-uri//Load\\csv__OLD"
	"Loads a .csv file to a table datatype."
	{
		argsn 1
		arg `file-uri - location of csv file to load`
		returns `Table parsed from the CSV file.`
	}

	{
		equal { type? Load\csv__OLD %data/file.txt } 'table
	}

	{
		"equal {\ncc os\nf:: mktemp ++ \"/test.csv\"\nspr1:: table { \"a\" \"b\" \"c\" } { 1 1.1 \"a\" 2 2.2 \"b\" 3 3.3 \"c\" }\nf .Save\\csv spr1\nspr2:: Load\\csv f |autotype 1.0\nspr1 = spr2\n} true"
	}

	group "file-uri//Load\\csv"
	"Loads a .csv file to a table datatype."
	{
		argsn 2
		arg `file-uri - location of csv file to load`
		arg `separator - single character used as the column separator`
		returns `Table parsed from the CSV file.`
	}

	{
		equal { type? Load\csv %data/file.txt "," } 'table
	}

	{
		"equal {\ncc os\nf:: mktemp ++ \"/test.csv\"\nspr1:: table { \"a\" \"b\" \"c\" } { 1 1.1 \"a\" 2 2.2 \"b\" 3 3.3 \"c\" }\nf .Save\\csv spr1\nspr2:: Load\\csv f \",\" |autotype 1.0\nspr1 = spr2\n} true"
	}

	group "file-uri//Load\\csv\\ignore-bad"
	"Loads a .csv file to a table datatype, parsing it line by line and skipping lines that can't be parsed as CSV."
	{
		argsn 2
		arg `file-uri - location of csv file to load`
		arg `separator - single character used as column separator`
		returns `Table parsed from the CSV file, skipping malformed lines.`
	}

	{
	}

	{
		"equal {\ncc os\nf:: mktemp ++ \"/test.csv\"\nf .Write \"a;b;c\\n1;1.1;a\\nbad\\\"line\\n2;2.2;b\\n3;3.3;c\\n\"\nspr:: Load\\csv\\ignore-bad f \";\"\nspr .length? 3\n} true"
	}

	group "file-uri//Load\\tsv"
	"Loads a .tsv file to a table datatype."
	{
		argsn 1
		arg `file-uri - location of tsv file to load`
		returns `Table parsed from the TSV file.`
	}

	{
		equal { type? Load\tsv %data/file.txt } 'table
	}

	{
		"equal {\ncc os\nf:: mktemp ++ \"/test.tsv\"\nspr1:: table { \"a\" \"b\" \"c\" } { 1 1.1 \"a\" 2 2.2 \"b\" 3 3.3 \"c\" }\nf .Save\\tsv spr1\nspr2:: Load\\tsv f |autotype 1.0\nspr1 = spr2\n} true"
	}

	group "file-uri//Save\\csv"
	"Saves a table to a .csv file."
	{
		argsn 2
		arg `file-uri - where to save the sheet as a .csv file`
		arg `table    - the table to save`
		returns `the saved Table.`
	}

	{
		equal { type? Save\csv (os/mktemp ++ "/save.csv") table { "a" "b" } { 1 "x" } } 'table
	}

	{
		"equal {\ncc os\nf:: mktemp ++ \"/test.csv\"\nspr1:: table { \"a\" \"b\" \"c\" } { 1 1.1 \"a\" 2 2.2 \"b\" 3 3.3 \"c\" }\nf .Save\\csv spr1\nspr2:: Load\\csv f \",\" |autotype 1.0\nspr1 = spr2\n} true"
	}

	group "file-uri//Save\\tsv"
	"Saves a table to a .tsv file."
	{
		argsn 2
		arg `file-uri - where to save the sheet as a .tsv file`
		arg `table    - the table to save`
		returns `the saved Table.`
	}

	{
		equal { type? Save\tsv (os/mktemp ++ "/save.tsv") table { "a" "b" } { 1 "x" } } 'table
	}

	{
		"equal {\ncc os\nf:: mktemp ++ \"/test.tsv\"\nspr1:: table { \"a\" \"b\" \"c\" } { 1 1.1 \"a\" 2 2.2 \"b\" 3 3.3 \"c\" }\nf .Save\\tsv spr1\nspr2:: Load\\tsv f |autotype 1.0\nspr1 = spr2\n} true"
	}

	group "file-uri//Load\\xlsx"
	"Loads the first sheet in an .xlsx file to a Table."
	{
		argsn 1
		arg `file-uri - location of xlsx file to load`
		returns `Table containing the first sheet of the XLSX file.`
	}

	{
		equal { type? Save\xlsx (os/mktemp ++ "/test.xlsx") table { "a" "b" } { 1 "x" 2 "y" } } 'table
	}

	{
		"equal {\ncc os\nf:: mktemp ++ \"/test.xlsx\"\nspr1:: table { \"a\" \"b\" \"c\" } { 1 1.1 \"a\" 2 2.2 \"b\" 3 3.3 \"c\" }\nf .Save\\xlsx spr1\nspr2:: Load\\xlsx f |autotype 1.0\nspr1 = spr2\n} true"
	}

	group "file-uri//Save\\xlsx"
	"Saves a Table to a .xlsx file."
	{
		argsn 2
		arg `file-uri - where to save the table as a .xlsx file`
		arg `table    - the table to save`
		returns `the saved Table.`
	}

	{
		equal { type? Save\xlsx (os/mktemp ++ "/save.xlsx") table { "a" "b" } { 1 "x" } } 'table
	}

	{
		"equal {\ncc os\nf:: mktemp ++ \"/test.xlsx\"\nspr1:: table { \"a\" \"b\" \"c\" } { 1 1.1 \"a\" 2 2.2 \"b\" 3 3.3 \"c\" }\nf .Save\\xlsx spr1\nspr2:: Load\\xlsx f |autotype 1.0\nspr1 = spr2\n} true"
	}

}
}
section "baseio/builtins_cmd.go" "Running other programs" {
section "Command Operations" "Running other programs" {
	group "cmd"
	"Create a command."
	{
		argsn 1
		arg `command: block or list containing a command arguments`
		returns `native command object`
	}

	{
		equal { cmd { echo -n Hello World } |Output } "Hello World"
		equal { cmd { echo -n Hello World |tr A-Z a-z |sed "s/hello/goodbye/" } |Output } "goodbye world"
		equal { cmd { echo -n "1 + 1 =" { 1 + 1 } } |Output } "1 + 1 = 2"
		equal { args: list { "two" "arguments" } cmd { printf "'%s' " ?args } |Output } "'two' 'arguments' "
	}

	{
	}

	group "command//Dir!"
	"Change the working directory of a command."
	{
		argsn 2
		arg `command: native command object`
		arg `dir: path to the working directory`
		returns `the original command object`
	}

	{
		equal { cmd { pwd } |Dir! %/ |Output |trim } "/"
	}

	{
	}

	group "command//Stdin!"
	"Change the standard input of a command."
	{
		argsn 2
		arg `command: native command object`
		arg `input: path to an input file, a native file object, or a reader`
		returns `the original command object`
	}

	{
	}

	{
	}

	group "command//Stdout!"
	"Change the standard output of a command."
	{
		argsn 2
		arg `command: native command object`
		arg `output: path to an output file, a native file object, or a writer`
		returns `the original command object`
	}

	{
	}

	{
	}

	group "command//Stderr!"
	"Change the standard error of a command."
	{
		argsn 2
		arg `command: native command object`
		arg `output: path to an output file, a native file object, or a writer`
		returns `the original command object`
	}

	{
	}

	{
	}

	group "command//Pipe"
	"Pipe the output of the first command to the input of the second command."
	{
		argsn 2
		arg `c1: first command writing to the pipe`
		arg `c2: second command reading from the pipe`
		returns `new native command object`
	}

	{
		equal { cmd { echo -n Hello World } |Pipe cmd { tr a-z A-Z } |Output } "HELLO WORLD"
	}

	{
	}

	group "command//Run"
	"Start a command and wait for it to finish."
	{
		argsn 1
		arg `command: native command object`
		returns `boolean true if the command executed successfully`
	}

	{
		error { cmd { false } |Run }
	}

	{
	}

	group "command//Start"
	"Start a command (and any piped commands) without waiting."
	{
		argsn 1
		arg `command: native command object`
		returns `the same command after starting it (does not wait)`
	}

	{
	}

	{
	}

	group "command//Kill"
	"Kill a started command (and any started piped commands)."
	{
		argsn 1
		arg `command: native command object`
		returns `boolean true; kills the process (and any started piped processes)`
	}

	{
	}

	{
	}

	group "command//Pid"
	"Return the process id of the main command (or -1 if not started)."
	{
		argsn 1
		arg `command: native command object`
		returns `process id of the main command or -1 if not started`
	}

	{
	}

	{
	}

	group "command//Wait"
	"Wait for a started command to finish and return its exit status."
	{
		argsn 1
		arg `command: native command object`
		returns `exit status (or list for pipelines) after waiting`
	}

	{
	}

	{
	}

	group "command//Status"
	"Start a command, wait for it to finish, and return its exit status."
	{
		argsn 1
		arg `command: native command object`
		returns `for simple command: exit status integer; for pipeline: list of exit status integers`
	}

	{
		equal { cmd { true } |Status } 0
		equal { cmd { false } |Status } 1
		equal { cmd { false |true } |Status } list [ 1 0 ]
	}

	{
	}

	group "command//Output"
	"Start a command, wait for it to finish, and return its standard output"
	{
		argsn 1
		arg `command: native command object`
		returns `string containing data written to the command's standard output`
	}

	{
	}

	{
	}

	group "command//CombinedOutput"
	"Start a command, wait for it to finish, and return its combined standard output and error"
	{
		argsn 1
		arg `command: native command object`
		returns `string containing data written to the command's standard output and error`
	}

	{
	}

	{
	}

	group "command//Detach!"
	"Redirect stdin, stdout, and stderr of a command to /dev/null."
	{
		argsn 1
		arg `command: native command object`
		returns `the original command object after redirecting stdin/stdout/stderr to /dev/null`
	}

	{
	}

	{
	}

}
}
section "baseio/builtins_os.go" "OS related functions" {
section "OS" "OS related functions" {
	group "cwd?"
	"Gets the current working directory."
	{
		arg `none`
		returns `uri representing the current working directory`
	}

	{
		; equal { cc os cd %/tmp cwd? cd %.. } %/tmp
	}

	{
		"cc os\nprint cwd?\nls |for { .print }\nls\\ 'files |for { .print }\nhost-info? -> \"hostname\" |print\nload-avg? -> \"1\" |print\nvirtual-memory? -> \"total\" |print\ndisk-usage? |print\nprocesses? |first |print\n\ncc os cwd?"
	}

	group "does-exist"
	"Checks if a file or directory exists."
	{
		argsn 1
		arg `path: uri representing the file or directory to check`
		returns `boolean: true if exists, false if not`
	}

	{
		equal { cc os does-exist %main.rye } true
	}

	{
		"cc os does-exist %./tests/data/file.txt"
	}

	group "cd"
