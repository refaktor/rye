section "SMTP Server Functions " "Creating and running SMTP mail servers." {
	group "smtp-server" 
	"Creates a new SMTP server that can receive incoming email messages on the specified address."
	{
		argsn 1
		arg `address: String containing the server address (e.g., ":2525", "localhost:587")`
		returns `native smtpd object configured to listen on the specified address`
	}

	{
		equal { smtp-server 2525 |type? } 'native
		equal { smtp-server ":2525" |kind? } 'smtpd
	}

	{
	}

	group "smtpd//Serve" 
	"Starts the SMTP server listening for incoming emails and calls the handler function for each received message."
	{
		argsn 4
		arg `server: Native smtpd object created by smtp-server`
		arg `handler: Function that processes incoming emails (reader from to origin -> ...)`
		arg `appname: String name for the SMTP server application`
		arg `password: String password for SMTP authentication (empty string for no auth)`
		returns `the server object after starting to listen, or error if unable to serve`
	}

	{
	}

	{
`handler: fn { reader from to origin } { print "Got email from:" from }
smtp-server ":2525"
|Serve handler "TestSMTP" ""
`	}

}

section "MQTT Client Functions " "" {
	group "mqtt-uri//Open" 
	"Opens a connection to an MQTT broker."
	{
		argsn 1
		arg `uri: MQTT broker URI (format: mqtt://[user:pass@]host:port/client-id)`
		returns `native MQTT client connection (type: "mqtt-client")error if connection fails`
	}

	{
		example { Open mqtt://localhost:1883/my-client-id }
		example { Open mqtt://user:pass@localhost:1883/my-client-id }
	}

	{
`; Connect to MQTT broker and subscribe to topics
client: Open mqtt://localhost:1883/my-client
client .Subscribe "sensors/+" 1 fn { payload msg } {
print "Topic: " + msg -> "topic"
print "Data: " + payload
}

; Publish messages
client .Publish-simple "sensors/temperature" "23.5"
client .Publish "sensors/humidity" "65" 1 0

; Clean up
client .Disconnect

`	}

	group "mqtt-client//Disconnect" 
	"Disconnects from the MQTT broker."
	{
		argsn 1
		arg `client: MQTT client connection (type: "mqtt-client")`
		returns `integer 1 for successerror if disconnection fails`
	}

	{
		example { client |Disconnect }
	}

	{
	}

	group "mqtt-client//Close" 
	"Closes the MQTT client connection (alias for Disconnect)."
	{
		argsn 1
		arg `client: MQTT client connection (type: "mqtt-client")`
		returns `integer 1 for successerror if close fails`
	}

	{
		equal { client: Open mqtt://localhost:1883/my-client client .Close |type? } 'integer
	}

	{
	}

	group "mqtt-client//Publish" 
	"Publishes a message to an MQTT topic with specified QoS and retain flag."
	{
		argsn 5
		arg `client: MQTT client connection (type: "mqtt-client")`
		arg `topic: Topic to publish to (string)`
		arg `payload: Message payload (string)`
		arg `qos: Quality of Service level (integer 0, 1, or 2)`
		arg `retain: Whether message should be retained (boolean)`
		returns `integer 1 for successerror if publish fails`
	}

	{
		example { client |Publish "sensors/temperature" "23.5" 0 false }
	}

	{
	}

	group "mqtt-client//Publish-simple" 
	"Publishes a message to an MQTT topic with default settings (QoS 0, no retain)."
	{
		argsn 3
		arg `client: MQTT client connection (type: "mqtt-client")`
		arg `topic: Topic to publish to (string)`
		arg `payload: Message payload (string)`
		returns `integer 1 for success (uses QoS 0, no retain)error if publish fails`
	}

	{
		example { client |Publish-simple "sensors/temperature" "23.5" }
	}

	{
	}

	group "mqtt-client//Subscribe" 
	"Subscribes to an MQTT topic with a message handler function."
	{
		argsn 4
		arg `client: MQTT client connection (type: "mqtt-client")`
		arg `topic: Topic pattern to subscribe to (string, can include wildcards)`
		arg `qos: Quality of Service level (integer 0, 1, or 2)`
		arg `handler: Callback function to handle received messages`
		returns `integer 1 for successerror if subscription fails`
	}

	{
		example { client |Subscribe "sensors/+" 1 fn { msg } { print "Received: " + msg } }
	}

	{
	}

	group "mqtt-client//Subscribe-simple" 
	"Subscribes to an MQTT topic with default QoS 0 and a message handler function."
	{
		argsn 3
		arg `client: MQTT client connection (type: "mqtt-client")`
		arg `topic: Topic pattern to subscribe to (string)`
		arg `handler: Callback function to handle received messages`
		returns `integer 1 for success (uses QoS 0)error if subscription fails`
	}

	{
		example { client |Subscribe-simple "sensors/temperature" fn { msg } { print msg.payload } }
	}

	{
	}

	group "mqtt-client//Unsubscribe" 
	"Unsubscribes from an MQTT topic."
	{
		argsn 2
		arg `client: MQTT client connection (type: "mqtt-client")`
		arg `topic: Topic to unsubscribe from (string)`
		returns `integer 1 for successerror if unsubscription fails`
	}

	{
		example { client |Unsubscribe "sensors/temperature" }
	}

	{
	}

	group "mqtt-client//Is-connected" 
	"Checks if the MQTT client is currently connected to the broker."
	{
		argsn 1
		arg `client: MQTT client connection (type: "mqtt-client")`
		returns `integer 1 if connected, 0 if not connected`
	}

	{
		example { client |Connected? }
	}

	{
	}

	group "mqtt-options" 
	"Creates a new MQTT client options object for advanced configuration."
	{
		returns `new MQTT client options object (type: "mqtt-options")`
	}

	{
		example { mqtt-options |Set-clean-session 1 |Set-keep-alive 60 |Set-timeout 30 }
	}

	{
	}

	group "mqtt-options//Set-broker" 
	"Sets the MQTT broker address in the options."
	{
		argsn 2
		arg `options: MQTT options object (type: "mqtt-options")`
		arg `broker: Broker URI string`
		returns `the same options object (for method chaining)`
	}

	{
		example { opts |Set-broker "tcp://localhost:1883" }
	}

	{
	}

	group "mqtt-options//Set-client-id" 
	"Sets the client ID in the MQTT options."
	{
		argsn 2
		arg `options: MQTT options object (type: "mqtt-options")`
		arg `client-id: Client identifier string`
		returns `the same options object (for method chaining)`
	}

	{
		example { opts |Set-client-id "my-unique-client" }
	}

	{
	}

	group "mqtt-options//Set-keep-alive" 
	"Sets the keep alive interval in seconds."
	{
		argsn 2
		arg `options: MQTT options object (type: "mqtt-options")`
		arg `seconds: Keep alive interval in seconds (integer)`
		returns `the same options object (for method chaining)`
	}

	{
		example { opts |Set-keep-alive 60 }
	}

	{
	}

	group "mqtt-options//Set-username" 
	"Sets the username for MQTT authentication."
	{
		argsn 2
		arg `options: MQTT options object (type: "mqtt-options")`
		arg `username: Username string for MQTT authentication`
		returns `the same options object (for method chaining)`
	}

	{
		example { opts |Set-username "myuser" }
	}

	{
	}

	group "mqtt-options//Set-password" 
	"Sets the password for MQTT authentication."
	{
		argsn 2
		arg `options: MQTT options object (type: "mqtt-options")`
		arg `password: Password string for MQTT authentication`
		returns `the same options object (for method chaining)`
	}

	{
		example { opts |Set-password "mypassword" }
	}

	{
	}

	group "mqtt-options//Set-will" 
	"Sets the Last Will and Testament message with QoS and retain flag."
	{
		argsn 5
		arg `options: MQTT options object (type: "mqtt-options")`
		arg `topic: Will topic string`
		arg `payload: Will message payload string`
		arg `qos: Quality of Service level for will message (integer 0, 1, or 2)`
		arg `retain: Whether will message should be retained (integer 0 = false, 1 = true)`
		returns `the same options object (for method chaining)`
	}

	{
		example { opts |Set-will "client/status" "offline" 1 1 }
	}

	{
	}

	group "mqtt-options//Connect-with-options" 
	"Creates and connects an MQTT client using the configured options."
	{
		argsn 1
		arg `options: MQTT options object (type: "mqtt-options")`
		returns `native MQTT client connection (type: "mqtt-client")error if connection fails`
	}

	{
		example { opts |Connect-with-options }
	}

	{
	}

}

