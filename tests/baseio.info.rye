section "Email Operations" "Email sending and SMTP communication" {
	group "email//Send"
	"Sends an email to the specified address."
	{
		argsn 2
		arg `to: email address to send to`
		arg `message: string containing the email message`
		returns `integer 1 if successful`
	}

	{
	}

	{
	}

}

section "FTP Operations" "File Transfer Protocol operations and connections" {
	group "ftp-uri//Open"
	"Opens a connection to an FTP server."
	{
		argsn 1
		arg `server: uri representing the FTP server to connect to`
		returns `native ftp-connection object`
	}

	{
	}

	{
	}

	group "ftp-connection//Login"
	"Logs in to an FTP server connection."
	{
		argsn 3
		arg `connection: native ftp-connection object`
		arg `username: string containing the username`
		arg `password: string containing the password`
		returns `the connection object if successful`
	}

	{
	}

	{
	}

	group "ftp-connection//Retrieve"
	"Retrieves a file from an FTP server."
	{
		argsn 2
		arg `connection: native ftp-connection object`
		arg `path: string containing the path of the file to retrieve`
		returns `native reader object for the retrieved file`
	}

	{
	}

	{
	}

	group "ftp-connection//Close"
	"Closes an FTP server connection."
	{
		argsn 1
		arg `connection: native ftp-connection object`
		returns `integer 1 for success; error if close fails`
	}

	{
	}

	{
		"equal { ftp: Open ftp://localhost:21\t ftp .Close |type? } 'integer"
	}

	group "ftp-connection//List"
	"Lists directory entries. Returns a block of maps with full info."
	{
		argsn 2
		arg `connection: native FTP connection.`
		arg `path: String directory path to list.`
		returns `Block of dicts describing each directory entry.`
	}

	{
	}

	{
		"; Requires ftp server on localhost:21 with anonymous or test creds\n; Example smoke tests (skip in CI if no server):\n; conn: ftp-uri: Open ftp://localhost:21\n; conn: conn .Login \"anonymous\" \"anonymous\" ; or real creds\n; conn .Cwd \"/\" |kind? |equal 'native\n; conn .Mkdir \"rye-test\" |kind? |equal 'native\n; conn .List \"/\" |type? |equal 'block\n; conn .Store \"/rye-test/hello.txt\" \"hi\" |kind? |equal 'native\n; r: conn .Retrieve \"/rye-test/hello.txt\" |kind? |equal 'reader\n; r .Close |drop\n; lst: conn .List \"/rye-test\"\n; lst |length |>= 1 |assert\n; conn .Rename \"/rye-test/hello.txt\" \"/rye-test/hello2.txt\" |kind? |equal 'native\n; conn .Delete \"/rye-test/hello2.txt\" |kind? |equal 'native\n; conn .Rmdir \"/rye-test\" |kind? |equal 'native\n; conn .Close |equal 1\nAdditional FTP operations"
	}

	group "ftp-connection//Cwd"
	"Changes working directory."
	{
		argsn 2
		arg `connection: native FTP connection.`
		arg `path: String directory to change to.`
		returns `the FTP connection.`
	}

	{
	}

	{
		"; conn .Cwd \"/\" |kind? |equal 'native"
	}

	group "ftp-connection//Mkdir"
	"Creates a directory."
	{
		argsn 2
		arg `connection: native FTP connection.`
		arg `path: String directory to create.`
		returns `the FTP connection.`
	}

	{
	}

	{
		"; conn .Mkdir \"rye-test\" |kind? |equal 'native"
	}

	group "ftp-connection//Rmdir"
	"Removes a directory."
	{
		argsn 2
		arg `connection: native FTP connection.`
		arg `path: String directory to remove.`
		returns `the FTP connection.`
	}

	{
	}

	{
		"; conn .Rmdir \"rye-test\" |kind? |equal 'native"
	}

	group "ftp-connection//Delete"
	"Deletes a file."
	{
		argsn 2
		arg `connection: native FTP connection.`
		arg `path: String file to delete.`
		returns `the FTP connection.`
	}

	{
	}

	{
		"; conn .Delete \"/rye-test/hello.txt\" |kind? |equal 'native"
	}

	group "ftp-connection//Rename"
	"Renames or moves a file."
	{
		argsn 3
		arg `connection: native FTP connection.`
		arg `from: String current path.`
		arg `to: String new path.`
		returns `the FTP connection.`
	}

	{
	}

	{
		"; conn .Rename \"/rye-test/a.txt\" \"/rye-test/b.txt\" |kind? |equal 'native"
	}

	group "ftp-connection//Store"
	"Uploads data to a remote path. Accepts string or reader."
	{
		argsn 3
		arg `connection: native FTP connection.`
		arg `path: String remote destination path.`
		arg `reader: Reader supplying the file contents.`
		returns `the FTP connection.`
	}

	{
	}

	{
		"; conn .Store \"/rye-test/up.txt\" \"content\" |kind? |equal 'native"
	}

}

section "File Monitoring" "File watching and tailing operations" {
	group "tail-file"
	"Tails a file, following it for new content. Used for monitoring log files."
	{
		argsn 3
		arg `path: uri or string representing the file to tail`
		arg `follow: boolean indicating whether to follow the file for new content`
		arg `reopen: boolean indicating whether to reopen the file if it's rotated`
		returns `native tail-file object that can be used to read lines as they are added`
	}

	{
	}

	{
	}

	group "tail-file//Read-line"
	"Reads the next line from a tailed file. Blocks until a line is available."
	{
		argsn 1
		arg `tail: native tail-file object`
		returns `string containing the next line from the file, or nil if no more lines`
	}

	{
	}

	{
	}

	group "tail-file//Close"
	"Closes a tailed file, stopping the monitoring."
	{
		argsn 1
		arg `tail: native tail-file object`
		returns `empty string if successful`
	}

	{
	}

	{
	}

}

