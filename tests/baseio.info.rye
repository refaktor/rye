section "Archive Functions" "Functions for creating and extracting archives" {
	group "tgz"
	"Creates a .tar.gz archive from a file or directory."
	{
		argsn 2
		arg `source: uri representing the file or directory to archive`
		arg `destination: uri representing the output .tar.gz file`
		returns `destination uri if successful`
	}

	{
	}

	{
	}

	group "un-tgz"
	"Removed: use untgz instead."
	{
		argsn 2
		arg `source: uri representing the .tar.gz file`
		arg `destination: uri representing the output directory`
		returns `never returns successfully; raises an error directing callers to untgz`
	}

	{
	}

	{
	}

	group "zip"
	"Creates a .zip archive from a file or directory, or from a block of files/directories."
	{
		argsn 2
		arg `source: uri representing the file or directory to archive, or a block of uris/strings to archive together`
		arg `destination: uri representing the output .zip file`
		returns `destination uri if successful`
	}

	{
	}

	{
	}

	group "unzip"
	"Extracts a .zip archive to a directory."
	{
		argsn 2
		arg `source: uri representing the .zip file`
		arg `destination: uri representing the output directory`
		returns `destination uri if successful`
	}

	{
	}

	{
	}

	group "unzip\\single"
	"Opens the single file in a .zip archive and returns a reader for it. Fails if the archive contains more than one file."
	{
		argsn 1
		arg `source: uri representing the .zip file, or a reader/http-response native containing .zip data`
		returns `native reader object for the archive's only file (fails if there is more than one)`
	}

	{
	}

	{
	}

}

section "Find" "File finding functions using go-find library" {
	group "finder"
	"Creates a new file finder starting from the given path(s)."
	{
		argsn 1
		arg `path: uri or block of uris/strings representing starting paths`
		returns `native finder object`
	}

	{
	}

	{
		"finder %src |Name \"*.go\" |Type 'file |Eval\nfinder %. |Max-depth! 2 |Name \"*.txt\" |Eval\nfinder %/home |Min-depth! 1 |Max-depth! 3 |Regex regex \"test.*\\.go$\" |Eval\nCreates a new finder starting from the given path(s)."
	}

	group "finder//Min-depth!"
	"Sets the minimum depth for file traversal."
	{
		argsn 2
		arg `finder: native finder object`
		arg `depth: integer minimum depth`
		returns `native finder object (for chaining)`
	}

	{
	}

	{
	}

	group "finder//Max-depth!"
	"Sets the maximum depth for file traversal."
	{
		argsn 2
		arg `finder: native finder object`
		arg `depth: integer maximum depth`
		returns `native finder object (for chaining)`
	}

	{
	}

	{
	}

	group "finder//Type"
	"Filters results by type: 'file (or \"f\") for files, 'dir (or \"d\") for directories."
	{
		argsn 2
		arg `finder: native finder object`
		arg `type: word 'file or 'dir (or string "f" or "d")`
		returns `native finder object (for chaining)`
	}

	{
	}

	{
	}

	group "finder//Name"
	"Filters results by file name using a glob pattern."
	{
		argsn 2
		arg `finder: native finder object`
		arg `pattern: string glob pattern (e.g., "*.go", "test_*")`
		returns `native finder object (for chaining)`
	}

	{
	}

	{
	}

	group "finder//Whole-name"
	"Filters results by full path using a glob pattern."
	{
		argsn 2
		arg `finder: native finder object`
		arg `pattern: string glob pattern for the whole path`
		returns `native finder object (for chaining)`
	}

	{
	}

	{
	}

	group "finder//Regex"
	"Filters results by regular expression on the full path."
	{
		argsn 2
		arg `finder: native finder object`
		arg `regex: native regex object`
		returns `native finder object (for chaining)`
	}

	{
	}

	{
	}

	group "finder//Empty"
	"Filters for empty files or directories."
	{
		argsn 1
		arg `finder: native finder object`
		returns `native finder object (for chaining)`
	}

	{
	}

	{
	}

	group "finder//Mtime-since!"
	"Filters for files modified within the last N milliseconds (e.g. 2 .days), truncated to whole seconds."
	{
		argsn 2
		arg `finder: native finder object`
		arg `millis: integer number of milliseconds (Rye durations such as 2 .days are in milliseconds)`
		returns `native finder object (for chaining)`
	}

	{
	}

	{
	}

	group "finder//Exclude-path"
	"Excludes paths that match a string substring or glob pattern."
	{
		argsn 2
		arg `finder: native finder object`
		arg `pattern: string substring or glob pattern to exclude`
		returns `native finder object (for chaining)`
	}

	{
	}

	{
	}

	group "finder//Size>"
	"Filters for entries with size greater than N bytes."
	{
		argsn 2
		arg `finder: native finder object`
		arg `bytes: integer minimum exclusive size`
		returns `native finder object (for chaining)`
	}

	{
	}

	{
	}

	group "finder//Eval"
	"Executes the find operation and returns matching paths as uris."
	{
		argsn 1
		arg `finder: native finder object`
		returns `block of paths; uris by default, or strings according to finder//Path-mode!`
	}

	{
	}

	{
	}

	group "finder//Path-mode!"
	"Sets how finder Eval returns paths: 'full (absolute string), 'relative (to cwd, string), 'filenames (basename string), or 'uris (the default)."
	{
		argsn 2
		arg `finder: native finder object`
		arg `mode: word or string, one of 'full, 'relative, 'filenames, or 'uris`
		returns `native finder object (for chaining)`
	}

	{
	}

	{
	}

}

