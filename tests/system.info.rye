	group "net-interface?" 
	"Looks up a network interface by name and returns it as a native object."
	{
		argsn 1
		arg `name: String name of the network interface (e.g., "eth0", "tailscale0", "lo")`
		returns `native net-iface object representing the interface, or error if not found`
	}

	{
		; equal { net-interface-by-name "lo" |type? } 'native
		; error { net-interface-by-name "no-such-iface-xyz" }
	}

	{
	}

	group "net-iface//Addrs?" 
	"Returns a block of network addresses assigned to the interface."
	{
		argsn 1
		arg `iface: Native net-iface object`
		returns `block of native net-addr objects assigned to the interface, or error`
	}

	{
	}

	{
`; iface: net-interface-by-name "lo"
; addrs: iface .Addrs?
`	}

	group "net-addr//IPNet?" 
	"Type-asserts a network address to *net.IPNet (CIDR form). Returns failure if the address is not an IP network."
	{
		argsn 1
		arg `addr: Native net-addr object (from net-iface//Addrs)`
		returns `native net-ipnet object if the address is an IP network, or failure if it isa plain net.Addr (e.g., a point-to-point address not yet assigned)`
	}

	{
	}

	{
`; addr: iface .Addrs? |first
; ipnet: addr .IPNet?
`	}

	group "net-ipnet//Loopback?" 
	"Reports whether the IP address in the IPNet is a loopback address."
	{
		argsn 1
		arg `ipnet: Native net-ipnet object`
		returns `boolean – true if the IP is a loopback address, false otherwise`
	}

	{
	}

	{
`; ipnet .Loopback?  ; returns true for 127.0.0.1/8
`	}

	group "net-ipnet//IPv4?" 
	"Reports whether the IP address in the IPNet is an IPv4 address (IP.To4() != nil)."
	{
		argsn 1
		arg `ipnet: Native net-ipnet object`
		returns `boolean – true if the IP address is IPv4, false if it is IPv6-only`
	}

	{
	}

	{
`; ipnet .IPv4?  ; returns true when the address is an IPv4 address
`	}

	group "net-ipnet//IP-string?" 
	"Returns the IP address contained in the IPNet as a dotted-decimal (or colon-separated) string."
	{
		argsn 1
		arg `ipnet: Native net-ipnet object`
		returns `string representation of the IP address (without the prefix length)`
	}

	{
	}

	{
`; ipnet .IP-string?  ; returns "100.64.0.1"
`	}

}

section "SSH " "SSH server functions" {
	group "ssh-server" 
	"Creates a new SSH server that listens on the specified address."
	{
		argsn 1
		arg `address: String containing host:port address to listen on`
		returns `native SSH server object`
	}

	{
		; equal { ssh-server "localhost:2222" |type? } 'native
	}

	{
`server: ssh-server "localhost:2222"
server |Password-auth { pass = "secret123" }
server |Handle fn { session } {
session .Write "Welcome to Rye SSH server!\n"
session .Write "Type 'exit' to quit.\n"
}
server |Serve

`	}

	group "ssh-server//Handle" 
	"Sets a handler function for SSH sessions on the server."
	{
		argsn 2
		arg `server: SSH server object`
		arg `handler: Function that receives an SSH session object`
		returns `the SSH server object`
	}

	{
		; equal { server: ssh-server "localhost:2222" , server |Handle { session |Write "Hello" } |type? } 'native
	}

	{
	}

	group "ssh-server//Password-auth" 
	"Sets a password authentication handler for the SSH server."
	{
		argsn 2
		arg `server: SSH server object`
		arg `handler: Function that receives a password string and returns true/false`
		returns `the SSH server object`
	}

	{
		; equal { server: ssh-server "localhost:2222" , server |Password-auth { pass = "secret" } |type? } 'native
	}

	{
	}

	group "ssh-server//Serve" 
	"Starts the SSH server, listening for connections."
	{
		argsn 1
		arg `server: SSH server object`
		returns `the SSH server object, or error if unable to serve`
	}

	{
		; equal { server: ssh-server "localhost:2222" , server |Serve |type? } 'native
	}

	{
	}

	group "ssh-session//Write" 
	"Writes a string to an SSH session."
	{
		argsn 2
		arg `session: SSH session object`
		arg `text: String to write to the session`
		returns `the SSH session object`
	}

	{
		; equal { session: ssh-session-mock , session |Write "Hello" |type? } 'native
	}

	{
	}

}

section "Default" "" {
	group "go-with" 
	"Executes a function in a separate goroutine, passing the specified value as an argument."
	{
		argsn 2
		arg `value: Object to pass to the goroutine function`
		arg `function: Function to execute in a separate goroutine, receives the value as argument`
		returns `the original value that was passed to the goroutine`
	}

	{
		equal { x:: 0 , go-with 5 fn { v } { change! v 'x } , sleep 100 , x } 5
		equal { y:: 0 , go-with "test" fn { v } { change! length? v 'y } , sleep 100 , y } 4
	}

	{
`; Simple goroutine with channel communication
ch: channel 1
go fn { } { ch .Send "Hello from goroutine" }
print ch .Read

; Using waitgroup to coordinate multiple goroutines
wg: waitgroup
results: channel 10
loop 5 { i |
wg .Add 1
go-with i fn { n } { results .Send n * 2 , wg .Done }
}
wg .Wait
results .Close

; Mutex for safe shared state
counter:: 0
mtx: mutex
go fn { } { mtx .Lock , change! counter + 1 'counter , mtx .Unlock }

`	}

	group "go" 
	"Executes a function in a separate goroutine without passing any arguments."
	{
		argsn 1
		arg `function: Function to execute in a separate goroutine (takes no arguments)`
		returns `the function that was executed`
	}

	{
		equal { x:: 0 , go fn { } { change! 42 'x } , sleep 100 , x } 42
		equal { y:: "unchanged" , go fn { } { change! "changed" 'y } , sleep 100 , y } "changed"
	}

	{
	}

	group "channel" 
	"Creates a new channel with the specified buffer size for goroutine communication."
	{
		argsn 1
		arg `buffer-size: Integer specifying the channel buffer size (0 for unbuffered)`
		returns `a new channel native object with the specified buffer size`
	}

	{
		equal { ch: channel 1 ,  ch .probe .lg .Send 42 , ch .Read } 42
		equal { ch: channel 2 , ch .Send 1 , ch .Send 2 , ch .Read } 1
		equal { channel 5 |type? } 'native
	}

	{
	}

	group "Rye-channel//Read" 
	"Reads the next value from a channel, blocking until a value is available or the channel is closed."
	{
		argsn 1
		arg `channel: Channel to read from`
		returns `the next value from the channel, or an error if the channel is closed`
	}

	{
		equal { ch: channel 1 , ch .Send 123 , ch .Read } 123
		equal { ch: channel 1 , ch .Send "test" , ch .Read } "test"
		equal { ch: channel 1 , ch .Close , try { ch .Read } |type? } 'error
	}

	{
	}

	group "Rye-channel//Send" 
	"Sends a value through a channel, blocking if the channel is unbuffered or full."
	{
		argsn 2
		arg `channel: Channel to send the value to`
		arg `value: Value to send through the channel`
		returns `the channel object`
	}

	{
		equal { ch: channel 1 , ch .Send 42 , ch .Read } 42
		equal { ch: channel 3 , ch .Send "A" , ch .Send "B" , ch .Read } "A"
		; equal { ch: channel 1 , ch .Send 100 , ch } ch
	}

	{
	}

	group "Rye-channel//Close" 
	"Closes a channel, preventing further sends and causing pending/future reads to return an error."
	{
		argsn 1
		arg `channel: Channel to close`
		returns `the closed channel object`
	}

	{
		equal { ch: channel 1 , ch .Send 42 , ch .Close , ch |type? } 'native
		equal { ch: channel 1 , ch .Close , ch .Send 123 |disarm |type? } 'error
		equal { ch: channel 2 , ch .Close , ch .Read |disarm |type? } 'error
	}

	{
	}

	group "mutex" 
	"Creates a new mutex for synchronizing access to shared resources between goroutines."
	{
		arg `(none)`
		returns `a new mutex native object for synchronization`
	}

	{
		equal { mutex |type? } 'native
		equal { mtx: mutex , mtx .Lock , mtx .Unlock , mtx |type? } 'native
	}

	{
	}

	group "waitgroup" 
	"Creates a new waitgroup for coordinating multiple goroutines to wait for completion."
	{
		arg `(none)`
		returns `a new waitgroup native object for coordinating goroutines`
	}

	{
		equal { waitgroup |type? } 'native
		equal { wg: waitgroup , wg .Add 1 , wg .Done , wg .Wait , wg |type? } 'native
	}

	{
	}

	group "Rye-mutex//Lock" 
	"Acquires the lock on a mutex, blocking until the lock becomes available."
	{
		argsn 1
		arg `mutex: Mutex to acquire the lock on`
		returns `the mutex object`
	}

	{
		equal { mtx: mutex , mtx .Lock , mtx |type? } 'native
		equal { mtx: mutex , mtx .Lock , mtx .Unlock , mtx .Lock , mtx |type? } 'native
	}

	{
	}

	group "Rye-mutex//Unlock" 
	"Releases the lock on a mutex, allowing other goroutines to acquire it."
	{
		argsn 1
		arg `mutex: Mutex to release the lock from`
		returns `the mutex object, or error if unlocking an unlocked mutex`
	}

	{
		equal { mtx: mutex , mtx .Lock , mtx .Unlock , mtx |type? } 'native
		equal { mtx: mutex , mtx .Unlock |disarm |type? } 'error
	}

	{
	}

	group "Rye-waitgroup//Add" 
	"Adds the specified count to the waitgroup counter, indicating how many goroutines to wait for."
	{
		argsn 2
		arg `waitgroup: Waitgroup to add goroutines to`
		arg `count: Number of goroutines to add to the wait counter`
		returns `the waitgroup object`
	}

	{
		equal { wg: waitgroup , wg .Add 3 , wg |type? } 'native
		equal { wg: waitgroup , wg .Add 1 , wg .Add 2 , wg |type? } 'native
	}

	{
	}

	group "Rye-waitgroup//Done" 
	"Decrements the waitgroup counter by one, indicating that a goroutine has completed."
	{
		argsn 1
		arg `waitgroup: Waitgroup to decrement the counter for`
		returns `the waitgroup object`
	}

	{
		equal { wg: waitgroup , wg .Add 1 , wg .Done , wg |type? } 'native
		equal { wg: waitgroup , wg .Add 2 , wg .Done , wg .Done , wg |type? } 'native
	}

	{
	}

	group "Rye-waitgroup//Wait" 
	"Blocks until the waitgroup counter reaches zero, meaning all goroutines have completed."
	{
		argsn 1
		arg `waitgroup: Waitgroup to wait on`
		returns `the waitgroup object after all goroutines have completed`
	}

	{
		equal { wg: waitgroup , wg .Add 1 , wg .Done , wg .Wait , wg |type? } 'native
		equal { wg: waitgroup , wg .Wait , wg |type? } 'native
	}

	{
	}

	group "select\\fn" 
	"Performs a select operation on multiple channels, executing functions when channels are ready or a default function."
	{
		argsn 1
		arg `block: Block containing channel-function pairs and optional default function`
		returns `the original block argument`
	}

	{
		equal { ch1: channel 1 , ch2: channel 1 , ch1 .Send 42 , select\fn { ch1 fn { v } { v } ch2 fn { v } { v + 1 } } } 42
		equal { ch: channel 1 , select\fn { ch fn { v } { v * 2 } fn { } { 999 } } } 999
	}

	{
	}

}

