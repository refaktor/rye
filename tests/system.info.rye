`cc os whoami
`	}

	group "which" 
	"Finds the path to an executable command."
	{
		argsn 1
		arg `command: string representing the command to check`
		returns `uri representing the path to the executable, or error if not foundTags: #system #command`
	}

	{
	}

	{
`cc os which "sh"
`	}

