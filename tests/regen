#!/usr/bin/env bash
# Generate each builtin's tests exactly once, grouped by its source directory.
# Run from any directory: ./tests/regen (or cd tests && ./regen).
set -euo pipefail
cd "$(dirname "$0")"

# Build from source so regen always uses the current rbit escaping rules,
# rather than an older binary left in cmd/rbit/.
rbit=$(mktemp "${TMPDIR:-/tmp}/rye-rbit.XXXXXX")
trap 'rm -f "$rbit"' EXIT
go build -o "$rbit" ../cmd/rbit

# Keep the order intentional and stable. Files without annotated tests still
# belong to the tree, but produce no groups; rbit handles those itself.
base=(
  builtins_boolean.go builtins_numbers.go builtins_strings.go
  builtins_time.go builtins_collections.go builtins_types.go
  builtins_contexts.go builtins_conditionals.go builtins_iteration.go
  builtins_functions.go builtins.go builtins_combinators.go
  builtins_printing_not.go builtins_error_handling.go builtins_mth.go
  builtins_intents.go builtins_table.go builtins_markdown.go builtins_validation.go
)
baseio=(
  builtins_printing.go builtins_baseio.go
  builtins_io.go builtins_table_files.go builtins_cmd.go builtins_os.go builtins_http.go
)
batteries=(
  builtins_email.go builtins_mail.go builtins_smtpd.go builtins_mqtt.go
  builtins_regexp.go builtins_json.go builtins_bson.go builtins_sxml.go
  builtins_html.go builtins_conversion.go builtins_encoding.go
  builtins_sqlite.go builtins_psql.go builtins_mysql.go builtins_crypto.go
  builtins_bcrypt.go builtins_math.go builtins_match.go builtins_eyr.go
  builtins_ssh.go builtins_goroutines.go builtins_complex.go
  builtins_structures.go builtins_vector.go builtins_matrix.go
)

# Fail before replacing anything if an input is missing (the old script could
# leave a diagnostic string inside an .info.rye file).
for entry in "${base[@]}"; do test -f "../evaldo/$entry" || { echo "Missing evaldo/$entry" >&2; exit 1; }; done
for entry in "${baseio[@]}"; do test -f "../baseio/$entry" || { echo "Missing baseio/$entry" >&2; exit 1; }; done
for entry in "${batteries[@]}"; do test -f "../batteries/$entry" || { echo "Missing batteries/$entry" >&2; exit 1; }; done

# One page per directory, one labelled source-file wrapper per input. Wrappers
# are ordinary Rye `section` calls and work in both test and doc mode.
for area in base baseio batteries; do
  case "$area" in
    base) directory=evaldo; files=("${base[@]}");;
    baseio) directory=baseio; files=("${baseio[@]}");;
    batteries) directory=batteries; files=("${batteries[@]}");;
  esac
  output=$(mktemp "./.${area}.info.XXXXXX")
  for source in "${files[@]}"; do
    # Skip files without documented groups (no empty entries in navigation).
    generated=$("$rbit" "../$directory/$source")
    if grep -q '^[[:space:]]*group ' <<< "$generated"; then
      printf 'section "%s/%s" "" {\n' "$directory" "$source" >> "$output"
      # rbit currently emits trailing spaces on group lines; strip these
      # without changing the tests or their ordering.
      printf '%s\n' "$generated" | sed 's/[[:blank:]]*$//' >> "$output"
      printf '}\n' >> "$output"
    fi
  done
  mv "$output" "$area.info.rye"
done

# The pipes tests reference a missing ./testdata/ directory and currently
# abort the entire suite. Add builtins_pipes.go once those tests can run.
# Topic pages were copies of the same tests. Remove those generated duplicates:
# only the three directory pages are now inputs to tests/main.rye.
rm -f table.info.rye formats.info.rye io.info.rye crypto.info.rye \
  dialects.info.rye protocols.info.rye system.info.rye pipes.info.rye web.info.rye
printf 'Regenerated base.info.rye, baseio.info.rye, batteries.info.rye\n'
