; Early Exit from Nested Structures
print "## Early Exit from Loops and Blocks"

; =============================================================================
; ^if inside loop exits function
; =============================================================================

assert\display "^if exits function from loop" {
	find-first1: fn { items target } {
		var 'idx 0
		for items { ::item
			^if item = target { idx }
			idx:: idx + 1
		}
		-1
	}
	find-first1 { "a" "b" "c" "d" } "c"
} 2

assert\display "^if not found returns default" {
	find-first2: fn { items target } {
		var 'idx 0
		for items { ::item
			^if item = target { idx }
			idx:: idx + 1
		}
		-1
	}
	find-first2 { "a" "b" "c" } "z"
} -1

assert\display "^if exits from nested for" {
	; ^if exits from function, even inside nested for loops
	search-2d3: fn { } {
		for { 0 1 2 } { ::i3
			for { 0 1 2 } { ::j3
				^if all { i3 = 1 j3 = 1 } { "found 1,1" }
			}
		}
		"not found"
	}
	search-2d3
} "found 1,1"

; =============================================================================
; ^if inside loop with loop counter
; =============================================================================

assert\display "^if with loop index" {
	first-over4: fn { items threshold } {
		var 'i 0
		for items { ::x
			^if x > threshold { i }
			i:: i + 1
		}
		-1
	}
	first-over4 { 1 3 5 7 9 } 4
} 2

; =============================================================================
; ^if inside do block
; =============================================================================

assert\display "^if inside do" {
	check-positive5: fn { x } {
		do {
			^if x < 0 { "negative" }
			^if x = 0 { "zero" }
		}
		"positive"
	}
	check-positive5 -5
} "negative"

assert\display "^if inside nested do" {
	deep-check6: fn { x } {
		do {
			do {
				do {
					^if x = 42 { "found it!" }
				}
			}
		}
		"not found"
	}
	deep-check6 42
} "found it!"

; =============================================================================
; ^if inside if block
; =============================================================================

assert\display "^if inside if block" {
	process7: fn { x } {
		if x > 0 {
			^if x > 100 { "too big" }
		}
		x * 2
	}
	process7 150
} "too big"

assert\display "^if inside if continues" {
	process8: fn { x } {
		if x > 0 {
			^if x > 100 { "too big" }
		}
		x * 2
	}
	process8 50
} 100

; =============================================================================
; ^if inside either branches
; =============================================================================

assert\display "^if in either true branch" {
	route9: fn { x } {
		either x > 0 {
			^if x > 100 { "huge positive" }
			"positive"
		} {
			"non-positive"
		}
	}
	route9 200
} "huge positive"

assert\display "^if in either false branch" {
	route10: fn { x } {
		either x > 0 {
			"positive"
		} {
			^if x < -100 { "huge negative" }
			"non-positive"
		}
	}
	route10 -200
} "huge negative"

print ""
