process5: fn { items } {
  var 'sum5 0
  for items { ::x5
    sum5:: sum5 + 10 / x5
  }
  sum5
}

process4: fn { items } {
  sum5:: 10 / first items
  sum5
}
process3: fn { items } {
  10 / first items
}
process2: fn { items } {
  print 10 / first items
}

