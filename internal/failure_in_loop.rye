; 20260726 detected this behaviour

try { for probe range 1 2 { 1 / 0 :x } } |with { term/bold , .probe , term/reset } ; try incorrectly returns 0 instead of failure, this means that failure needs to be detected before set word
try { for probe range 1 3 { 1 / 0 :y } } |with { term/bold , .probe , term/reset } ; and failure needs to be detected before next loop
; with fix z was also undefined then

print "-------------"

try { 1 / 0 :z , probe z } |probe ; , probe z                                               ; if failure happens it should escalate to error before it's set to a word
try { w: 1 / 0 , probe w } |probe ; , probe w                                             ; for the normal set-word it works as expected

print "============="

try { probe [ x y z ] } |probe
