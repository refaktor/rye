; CLI Integration tests - basic parse-args functionality
print "## CLI Integration Tests"

; Full spec parsing - verbose flag
assert\display "full spec parsing" {
	( parse-args { "--verbose" "-o" "out.txt" "in.txt" } {
		program "test-cli"
		description "Test CLI"
		-v|verbose flag doc "Verbose"
		-o|output string doc "Output file"
		input: string doc "Input file"
	} ) -> "verbose"
} true

; Full spec parsing - output value
assert\display "full spec output value" {
	( parse-args { "--verbose" "-o" "out.txt" "in.txt" } {
		-v|verbose flag
		-o|output string
		input: string
	} ) -> "output"
} "out.txt"

; Full spec parsing - positional value
assert\display "full spec positional value" {
	( parse-args { "--verbose" "-o" "out.txt" "in.txt" } {
		-v|verbose flag
		-o|output string
		input: string
	} ) -> "input"
} "in.txt"

print ""


assert\display "my test 1" {
	; Minimal variant: imgtool convert                                                                                                                                                                                
 spec2: {                                                                                                                                                                                                     
   program "imgtool"                                                                                                                                                                                               
   -v|verbose flag                                                                                                                                                                                                 
   -q|quality integer optional 85 doc "JPEG quality"                                                                                                                                                               
   input: string required doc "Input image"                                                                                                                                                                        
   output: string optional "out.jpg" doc "Output image"                                                                                                                                                            
 }                                                                                                                                                                                                                 
                                                                                                                                                                                                                   
 argv2: { "-v" "-q" 92 "in.png" "out.jpg" }                                                                                                                                                                   
 args2: parse-args argv2 spec2                                                                                                                                                                                
                                                                                                                                                                                                                   
 [ ( args2 -> "verbose" )    ; true                                                                                                                                                                              
 ( args2 -> "quality" )    ; 92                                                                                                                                                                                
 ( args2 |probe -> "input" )  ; "in.png"                                                                                                                                                                       
 ( args2 |probe -> "output" ) ; "out.jpg"                                                                                                                                                                  
 ] 
                                                
} [ "" "" ]
