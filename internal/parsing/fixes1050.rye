; Parser tests for fixes applied in Aug 2026
; Tests for: --> operator, kindwords ~(...), <=> operator, and error recovery

print "## Fixes Verification"

; ============================================
; --> operator (was broken: routed to readFlagword -> error)
; ============================================

assert\display "--> arrow operator parses as opword" {
	type? first { --> }
} 'opword

assert\display "--> arrow used inside expression" {
	length? { a --> b }
} 3

; ============================================
; <-- arrow operator (similar to -->)
; ============================================

assert\display "<-- arrow operator parses as opword" {
	type? first { <-- }
} 'opword

assert\display "<-- arrow used inside expression" {
	length? { a <-- b }
} 3

; ============================================
; <=> spaceship / comparison operator
; ============================================

assert\display "<=> spaceship operator parses as opword" {
	type? first { <=> }
} 'opword

assert\display "<=> inside expression" {
	length? { a <=> b }
} 3

; ============================================
; Kindwords ~(type)~ and ~(type) — now routed to readKindWord
; ============================================

assert\display "kindword ~(integer)~" {
	type? first { ~(integer)~ }
} 'kindword

assert\display "kindword ~(string)~" {
	type? first { ~(string)~ }
} 'kindword

assert\display "kindword ~(block)~" {
	type? first { ~(block)~ }
} 'kindword

assert\display "kindword ~(integer)  without trailing tilde" {
	type? first { ~(integer) }
} 'kindword

assert\display "kindword ~(string)  without trailing tilde" {
	type? first { ~(string) }
} 'kindword

assert\display "kindword ~(any-tag)~  with hyphen" {
	type? first { ~(any-tag)~ }
} 'kindword

; ============================================
; Kindwords in a block with surrounding tokens
; ============================================

assert\display "kindword inside block" {
	length? { ~(integer)~ 42 }
} 2

assert\display "kindword without tilde inside block" {
	length? { ~(integer) 42 }
} 2

; ============================================
; Kindword error: unclosed
; ============================================

assert\display "unclosed kindword ~(integer  errors" {
	try { do { load "~(integer" } } |type?
} 'error

assert\display "unclosed kindword error message mentions parenthesis" {
	try { do { load "~(integer" } } |message? |contains "parenthesis"
} true

; ============================================
; Error recovery: delimiter spacing error should not skip chars
; (was: readOneCharToken had extra l.readChar() on error)
; Verify that after a spacing error, subsequent valid tokens parse correctly.
; "1}2}" — first close fails (no space before }), second close } should also
; be an error, not consumed.
; ============================================

assert\display "delimiter spacing error still catches adjacent errors" {
	try { do { load "1}2}" } } |type?
} 'error

; ============================================
; peekCharOffs bounds check: -- at end of input should not panic
; ============================================

assert\display "decrement -- at end of input parses" {
	type? first { -- }
} 'opword

; The peekCharOffs fix prevents panic when checking chars beyond input length.
; This edge case is tested implicitly by all boundary-condition tests above.

; ============================================
; Spacing validation around kindwords
; ============================================

assert\display "kindword followed by word with space" {
	length? { ~(integer)~ word }
} 2

assert\display "kindword must have space after — errors when not" {
	try { do { load "~(integer)~word" } } |type?
} 'error

print ""
