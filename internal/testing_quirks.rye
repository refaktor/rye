; 27. STRING OPERATION EDGE CASES
; ══════════════════════════════════════════════════════════════════════════════

print "## String Edge Cases"

assert\display "split empty string" {
	"" .split ","
} { "" }

assert\display "contains empty needle" { ; TODO: maybe should return a failure
	"hello" .contains ""
} true

assert\display "index? not found returns -1" { ; TODO: probably should return a failure
	index? "hello" "xyz"
} -1

assert\display "index? empty string in non-empty returns 0" { ; TODO: probably failure
	index? "hello" ""
} 0

assert\display "substring within bounds" {
