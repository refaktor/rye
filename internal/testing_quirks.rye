; ══════════════════════════════════════════════════════════════════════════════
; 30. MATH CONTEXT QUIRKS
; ══════════════════════════════════════════════════════════════════════════════

print "## Math Context"

assert\display "math/abs of negative integer" {
	do\in math { abs -42 }
} 42

assert\display "math functions return decimals" {
	do\in math { sqrt 9 }
} 3.0

assert\display "math/pi available" {
	math/pi > 3.14
} true

