; 28. BLOCK OPERATIONS
; ══════════════════════════════════════════════════════════════════════════════

print "## Block Edge Cases"

assert\display "length of empty block" {
	length? { }
} 0

assert\display "replicate creates repeated block" { ; quirk true is a function that returns boolean true, so true in a passive block returns a block of 3 words
	replicate 3 { true }
} [ true true true ]

assert\display "block with mixed types" {
	first { 1 "two" 3.0 'four }
} 1

assert\display "nth on block" {  ; nth wors 1 based is correct - first second ... fifth .. 
	nth { "a" "b" "c" } 2
} "b"

assert\display "index out of bounds fails" {
	try { nth { "a" "b" } 5 } |type?
} 'error

